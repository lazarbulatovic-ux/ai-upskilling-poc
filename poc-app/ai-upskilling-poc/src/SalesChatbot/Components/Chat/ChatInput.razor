<div class="chat-input">
    <input @bind="_text"
           @bind:event="oninput"
           @onkeydown="HandleKeyDown"
           placeholder="Ask a sales question…"
           disabled="@Disabled"
           maxlength="2000" />
    <button @onclick="Submit" disabled="@(Disabled || string.IsNullOrWhiteSpace(_text))">Send</button>
</div>

@code {
    [Parameter, EditorRequired]
    public EventCallback<string> OnSend { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string _text = string.Empty;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_text))
        {
            return;
        }

        var message = _text.Trim();
        _text = string.Empty;
        await OnSend.InvokeAsync(message);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await Submit();
        }
    }
}
